  "narrative": {
    "northStar": "The publishing desk",
    "overview": "A precise, calm workspace for inspecting authored books. Typography provides hierarchy; ruled lists carry dense source information. Generated puzzles occupy an uncluttered paper surface, with their evidence beside them.",
    "keyCharacteristics": [
      "Editorial typography with compact interface controls.",
      "Flat surfaces, warm paper, restrained green and explicit status text.",
      "Real source and generated analysis, clearly distinguished."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Status color must accompany a precise text label and may only reflect an existing engine/validation result or explicit local draft state. Amber may identify unsaved changes; it must not imply a quality finding.",
        "section": "colors"
      },
      {
        "name": "The Source and Analysis Rule",
        "body": "Present authored configuration before generation; keep generation, verification and quality states distinct in all views.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve author-defined ordering and exact seed strings.",
      "Do use real placements for solutions and state coordinate conventions.",
      "Do keep source text escaped and long identities wrap-safe.",
      "Do preserve keyboard controls, focus visibility and non-color status cues."
    ],
    "donts": [
      "Don't fabricate cover, publishing or financial status.",
      "Don't introduce gradients, glass effects, decorative charts or nested cards.",
      "Don't imply that no quality findings means publication readiness.",
      "Don't present future workflows as working navigation."
    ]
  }
